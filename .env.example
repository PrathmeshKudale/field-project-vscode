DATABASE_URL=sqlite:///./kaushalsetu.db
# Enables Gemini guidance and live Google Search grounding. Keep backend-only.
# Check current Google AI Studio quotas and billing terms before use.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set this to your exact deployed frontend origin in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Google OAuth web client credentials. Keep the client secret on the backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
# For PostgreSQL, use:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kaushalsetu
