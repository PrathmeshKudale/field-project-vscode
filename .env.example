DATABASE_URL=sqlite:///./kaushalsetu.db
# Keep this key on the backend only. Never use a VITE_ prefix for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set this to your exact deployed frontend origin in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
